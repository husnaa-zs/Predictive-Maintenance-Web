# Copy this file to ".env" if you want to change settings. Nothing here is required.

# Default: a local SQLite file (no setup needed).
DATABASE_URL=sqlite:///data/pdm.db

# SQL Server example (install the "ODBC Driver 18 for SQL Server" first):
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost/PdmDb?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
